{
  "name": "@zhengrenwritecode/dsh-session-forging",
  "version": "0.3.0",
  "description": "Create DeepSeek Harness sessions from reusable templates with per-session instructions, memory, tools and usage limits. Share project documents and dispatch work across sessions.",
  "type": "module",
  "license": "MIT",
  "author": "sonbringer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonbringer/dsh-plugin-session-forging.git"
  },
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    ".": "./index.js",
    "./client": "./client.js",
    "./sources": "./src/sources.js",
    "./bindings": "./src/bindings.js",
    "./capabilities": "./src/capabilities.js",
    "./schemas/source.schema.json": "./schemas/source.schema.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cli.js",
    "cordis.patch.yml",
    "src",
    "schemas",
    "LICENSE",
    "README.md",
    "doc/handbook.md",
    "doc/spark-and-cog.md",
    "doc/use-cases",
    "sources",
    "locale"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "bin": {
    "session-forging": "./cli.js"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "session-templates",
    "agent-memory",
    "multi-agent"
  ]
}
